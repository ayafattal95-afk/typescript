{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    // ts code-folder
    "rootDir":  "./src",
    // js code-folder -> distributed -> dest
    "outDir": "./dist",
    "removeComments": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
